{
  "name": "clipboard-to-markdown",
  "version": "1.3.0",
  "description": "Local web app to convert clipboard HTML to Markdown",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:browser-app": "tsc --project tsconfig.browser.json",
    "build:browser": "npm run build && node dist/build-browser.js && npm run build:browser-app",
    "start": "npm run build && node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "test": "npm run build && mocha dist/test/**/*.test.js",
    "clean": "rm -rf dist dist-test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "clipboard",
    "markdown",
    "converter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "jsdom": "^28.1.0",
    "turndown": "^7.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "typescript": "^5.3.3"
  }
}
